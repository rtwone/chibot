NODE_ENV=development
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data

# Supabase public project config. The anon key is used only for public, RLS-protected reads.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Required server-only key for admin CRUD, sessions, and initial admin creation.
# Keep this secret; never expose it to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=
